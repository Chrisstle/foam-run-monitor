#!/bin/bash

# Usage: runCase [-n|--new] [-c|--continue] [-r|--reconstruct] [-h|--help]

# -----------------------------------------------------------------------------
# 1. Setup and Solver Detection
# -----------------------------------------------------------------------------


mode=""
customNP=""
quiet=false
forceNew=false
batchNewIfEmpty=false
isBatch=false
batchJobs=1
batchCases=()
originalArgs=()
invocationArgs=("$@")
animate=false
animArgs=()
keepProcessors=false
nonInteractive=false
allowClean=false
planOnly=false
outputFormat=text
RUNCASE_VERSION=2.0.0
RUNCASE_INTERFACE_VERSION=1
scriptPath=$(readlink -f -- "${BASH_SOURCE[0]}")
errorSymbol=""
receiptActive=false

fail() {
    local code="$1" symbol="$2"; shift 2
    errorSymbol="$symbol"
    if [[ "$planOnly" == true && "$outputFormat" == json ]]; then
        python3 - "$symbol" "$code" "$*" <<'PYJSON'
import json, os, sys
print(json.dumps(dict(ok=False, error=sys.argv[1], exitCode=int(sys.argv[2]), message=sys.argv[3], case=os.getcwd())))
PYJSON
    fi
    printf 'RUNCASE_ERROR=%s: %s\nCase: %s\n' "$symbol" "$*" "$PWD" >&2
    exit "$code"
}

interrupt_batch() {
    local code="$1" pid
    if [[ "$quiet" == false ]]; then
        stty echo 2>/dev/null || true
        tput rmcup 2>/dev/null || true
        printf '\033[?25h\033[?7h'
    fi
    for pid in "${pids[@]}"; do
        [[ -z "$pid" ]] || kill -TERM "$pid" 2>/dev/null || true
    done
    for pid in "${pids[@]}"; do
        [[ -z "$pid" ]] || wait "$pid" 2>/dev/null || true
    done
    fail "$code" INTERRUPTED "Batch interrupted; active workers were asked to stop."
}

interrupt_child() {
    local code="$1" child="$2"
    kill -TERM "$child" 2>/dev/null || true
    wait "$child" 2>/dev/null || true
    fail "$code" INTERRUPTED "Run interrupted; existing processor data was preserved."
}

set_mode() {
    [[ -z "$mode" || "$mode" == "$1" ]] || fail 2 INVALID_ARGUMENTS "Choose exactly one mode; got $mode and $1."
    mode="$1"
}

confirm_action() {
    local code="$1" symbol="$2" message="$3" reply
    [[ "$nonInteractive" == false ]] || fail "$code" "$symbol" "$message"
    read -r -p "$message [y/N]: " reply || fail 10 CONFIRMATION_REQUIRED "$message (no input available)"
    [[ "$reply" =~ ^[yY]([eE][sS])?$ ]] || fail 10 CANCELLED "$message (declined)"
}


# Reconstruction verification state. These are populated immediately before
# reconstructPar starts. Processor data is removed only if the same storage
# directories still exist afterwards and all expected objects pass verification.
reconstructionVerificationError=""
reconstructionProcessorDirs=()
reconstructionTimes=()
reconstructionObjects=()
declare -A reconstructionTimeSet=()
declare -A reconstructionObjectSet=()
declare -A reconstructionExpectedClass=()
declare -A reconstructionBeforeState=()
declare -A reconstructionProcessorDirState=()
declare -A batchCleanupApproved=()

set_reconstruction_verification_error() {
    reconstructionVerificationError="$1"
    return 1
}

is_openfoam_processor_dir_name() {
    local name="$1"
    [[ "$name" =~ ^processor[0-9]+$ \
        || "$name" =~ ^processors$ \
        || "$name" =~ ^processors[0-9]+$ \
        || "$name" =~ ^processors[0-9]+_[0-9]+-[0-9]+$ ]]
}

collect_openfoam_processor_dirs() {
    local path name
    collectedProcessorDirs=()

    while IFS= read -r -d '' path; do
        name=${path#./}
        if is_openfoam_processor_dir_name "$name"; then
            collectedProcessorDirs+=("$path")
        fi
    done < <(
        find . -mindepth 1 -maxdepth 1 -name 'processor*' \
            \( -type d -o -type l \) -print0 2>/dev/null
    )
}

case_has_openfoam_processor_data() {
    local caseDir="${1:-.}"
    local path name

    while IFS= read -r -d '' path; do
        name=${path##*/}
        if is_openfoam_processor_dir_name "$name"; then
            return 0
        fi
    done < <(
        find "$caseDir" -mindepth 1 -maxdepth 1 -name 'processor*' \
            \( -type d -o -type l \) -print0 2>/dev/null
    )

    return 1
}

is_openfoam_time_dir_name() {
    local name="$1"
    [[ "$name" =~ ^[+-]?(([0-9]+([.][0-9]*)?)|([.][0-9]+))([eE][+-]?[0-9]+)?$ ]]
}

is_zero_time_dir_name() {
    local name="$1"
    [[ "$name" =~ ^[+-]?(0+([.]0*)?|[.]0+)([eE][+-]?[0-9]+)?$ ]]
}

case_has_simulation_data() {
    local caseDir="${1:-.}"
    local timesOutput path name

    if case_has_openfoam_processor_data "$caseDir"; then
        return 0
    fi

    # Let OpenFOAM define which directory names are valid times. This covers
    # decimal, signed, and scientific notation across Foundation and ESI builds.
    if timesOutput=$(cd -- "$caseDir" && foamListTimes -noZero 2>/dev/null); then
        [[ -n "$(printf '%s\n' "$timesOutput" | awk 'NF { print; exit }')" ]]
        return
    fi

    # If foamListTimes cannot inspect the case, fail safe: recognize the common
    # scalar spellings ourselves and require confirmation rather than risk loss.
    while IFS= read -r -d '' path; do
        name=${path##*/}
        if is_openfoam_time_dir_name "$name" && ! is_zero_time_dir_name "$name"; then
            return 0
        fi
    done < <(find "$caseDir" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null)

    return 1
}

remove_openfoam_processor_dirs() {
    collect_openfoam_processor_dirs
    if [[ ${#collectedProcessorDirs[@]} -eq 0 ]]; then
        return 0
    fi
    rm -rf -- "${collectedProcessorDirs[@]}"
}

openfoam_command_supports_option() {
    local commandName="$1"
    local optionName="$2"

    command -v "$commandName" >/dev/null 2>&1 || return 1
    "$commandName" -help 2>&1 \
        | grep -qE -- "(^|[[:space:]])${optionName}([[:space:]]|$)"
}

collect_reconstructed_region_names() {
    local latestTime="$1"
    local searchRoot polyMeshDir regionName
    local -A seenRegions=()

    collectedRegionNames=()
    for searchRoot in constant "$latestTime"; do
        [[ -d "$searchRoot" ]] || continue
        while IFS= read -r -d '' polyMeshDir; do
            regionName=${polyMeshDir%/polyMesh}
            regionName=${regionName##*/}
            if [[ -n "$regionName" && -z "${seenRegions[$regionName]+x}" ]]; then
                seenRegions["$regionName"]=1
                collectedRegionNames+=("$regionName")
            fi
        done < <(
            find "$searchRoot" -mindepth 2 -maxdepth 2 -type d \
                -name polyMesh -print0 2>/dev/null
        )
    done
}

foam_file_class() {
    local path="$1"

    if [[ "$path" == *.gz ]]; then
        gzip -cd -- "$path" 2>/dev/null
    else
        sed -n '1,100p;100q' -- "$path" 2>/dev/null
    fi | awk '
        /^[[:space:]]*FoamFile([[:space:]]|$)/ { inHeader=1; next }
        inHeader && /^[[:space:]]*}/ { exit }
        inHeader && /^[[:space:]]*class[[:space:]]+/ {
            line=$0
            sub(/^[[:space:]]*class[[:space:]]+/, "", line)
            sub(/[[:space:]]*;.*/, "", line)
            print line
            exit
        }
    '
}

reconstructed_object_path() {
    local logicalPath="$1"

    if [[ -f "$logicalPath" ]]; then
        printf '%s\n' "$logicalPath"
    elif [[ -f "${logicalPath}.gz" ]]; then
        printf '%s\n' "${logicalPath}.gz"
    else
        return 1
    fi
}

reconstructed_object_state() {
    local path
    path=$(reconstructed_object_path "$1") || return 1
    stat -Lc '%y|%s|%i' -- "$path" 2>/dev/null
}

record_expected_reconstruction_object() {
    local logicalPath="$1"
    local expectedClass="$2"

    if [[ -z "${reconstructionObjectSet[$logicalPath]+x}" ]]; then
        reconstructionObjectSet["$logicalPath"]=1
        reconstructionObjects+=("$logicalPath")
        reconstructionExpectedClass["$logicalPath"]="$expectedClass"
        return 0
    fi

    # A collated source stores a decomposedBlockData wrapper instead of the
    # reconstructed class, so only the destination header can be checked.
    if [[ "${reconstructionExpectedClass[$logicalPath]}" == "__collated__" ]]; then
        return 0
    fi
    if [[ "$expectedClass" == "__collated__" ]]; then
        reconstructionExpectedClass["$logicalPath"]="__collated__"
    elif [[ "${reconstructionExpectedClass[$logicalPath]}" != "$expectedClass" ]]; then
        set_reconstruction_verification_error \
            "processor objects disagree on the class for '$logicalPath'"
        return 1
    fi
}

prepare_reconstruction_verification() {
    local fileHandlerArg="$1"
    local processorTimesOutput manifestFile sourcePath processorDir candidateDir
    local relativePath timeName logicalPath objectName sourceClass destination
    local -a fileHandlerArgs=()

    reconstructionVerificationError=""
    reconstructionProcessorDirs=()
    reconstructionTimes=()
    reconstructionObjects=()
    reconstructionTimeSet=()
    reconstructionObjectSet=()
    reconstructionExpectedClass=()
    reconstructionBeforeState=()
    reconstructionProcessorDirState=()

    [[ -n "$fileHandlerArg" ]] && fileHandlerArgs=(-fileHandler collated)

    collect_openfoam_processor_dirs
    if [[ ${#collectedProcessorDirs[@]} -eq 0 ]]; then
        set_reconstruction_verification_error \
            "no recognized OpenFOAM processor directories were found"
        return 1
    fi

    for processorDir in "${collectedProcessorDirs[@]}"; do
        if [[ -L "$processorDir" ]]; then
            set_reconstruction_verification_error \
                "processor storage '$processorDir' is a symbolic link"
            return 1
        fi
        reconstructionProcessorDirs+=("$processorDir")
        reconstructionProcessorDirState["$processorDir"]=$(stat -Lc '%d:%i' \
            -- "$processorDir" 2>/dev/null) || {
            set_reconstruction_verification_error \
                "could not identify processor storage '$processorDir'"
            return 1
        }
    done

    if ! processorTimesOutput=$(foamListTimes -processor \
        "${fileHandlerArgs[@]}" -noZero 2>/dev/null); then
        set_reconstruction_verification_error \
            "foamListTimes could not read the processor time directories"
        return 1
    fi

    while IFS= read -r timeName; do
        [[ -z "$timeName" ]] && continue
        reconstructionTimes+=("$timeName")
        reconstructionTimeSet["$timeName"]=1
    done <<< "$processorTimesOutput"

    if [[ ${#reconstructionTimes[@]} -eq 0 ]]; then
        set_reconstruction_verification_error \
            "no non-zero processor times were reported by foamListTimes"
        return 1
    fi

    manifestFile=$(mktemp log/.reconstruction-manifest.XXXXXX) || {
        set_reconstruction_verification_error \
            "could not create a temporary reconstruction manifest"
        return 1
    }

    if ! find "${reconstructionProcessorDirs[@]}" -type f -print0 \
        > "$manifestFile" 2>/dev/null; then
        rm -f -- "$manifestFile"
        set_reconstruction_verification_error \
            "could not inventory the processor files"
        return 1
    fi

    while IFS= read -r -d '' sourcePath; do
        processorDir=""
        for candidateDir in "${reconstructionProcessorDirs[@]}"; do
            if [[ "$sourcePath" == "$candidateDir"/* ]]; then
                processorDir="$candidateDir"
                break
            fi
        done

        if [[ -z "$processorDir" ]]; then
            rm -f -- "$manifestFile"
            set_reconstruction_verification_error \
                "could not identify the processor root for '$sourcePath'"
            return 1
        fi

        relativePath=${sourcePath#"$processorDir"/}
        timeName=${relativePath%%/*}
        [[ -z "${reconstructionTimeSet[$timeName]+x}" ]] && continue
        [[ "$relativePath" == "$timeName" ]] && continue

        logicalPath="$relativePath"
        [[ "$logicalPath" == *.gz ]] && logicalPath=${logicalPath%.gz}
        objectName=${logicalPath##*/}

        case "$objectName" in
            cellProcAddressing|faceProcAddressing|pointProcAddressing|boundaryProcAddressing)
                continue
                ;;
        esac

        if [[ ! -s "$sourcePath" ]]; then
            rm -f -- "$manifestFile"
            set_reconstruction_verification_error \
                "processor object '$sourcePath' is empty"
            return 1
        fi

        sourceClass=$(foam_file_class "$sourcePath")
        if [[ -z "$sourceClass" ]]; then
            rm -f -- "$manifestFile"
            set_reconstruction_verification_error \
                "could not read the FoamFile class from '$sourcePath'"
            return 1
        fi

        if [[ "${processorDir#./}" == processors* ]]; then
            sourceClass="__collated__"
        fi

        if ! record_expected_reconstruction_object "$logicalPath" "$sourceClass"; then
            rm -f -- "$manifestFile"
            return 1
        fi
    done < "$manifestFile"

    rm -f -- "$manifestFile"

    if [[ ${#reconstructionObjects[@]} -eq 0 ]]; then
        set_reconstruction_verification_error \
            "the processor manifest contained no reconstructable objects"
        return 1
    fi

    for logicalPath in "${reconstructionObjects[@]}"; do
        destination=$(reconstructed_object_path "$logicalPath" 2>/dev/null || true)
        if [[ -n "$destination" ]]; then
            reconstructionBeforeState["$logicalPath"]=$(reconstructed_object_state \
                "$logicalPath" || true)
        else
            reconstructionBeforeState["$logicalPath"]=""
        fi
    done

    return 0
}

verify_reconstructed_data() {
    local reconstructAllRegions="${2:-false}"
    local rootTimesOutput timeName logicalPath destination destinationClass regionName
    local beforeState afterState processorDir latestTime
    local checkedRegionMesh=false
    local -a currentProcessorDirs=()
    local -a checkMeshArgs=()
    local -A rootTimeSet=()
    local -A currentProcessorDirSet=()

    if ! grep -qE '^End[[:space:]]*$' log/log.reconstructPar 2>/dev/null; then
        set_reconstruction_verification_error \
            "reconstructPar did not write its normal End marker"
        return 1
    fi

    if ! rootTimesOutput=$(foamListTimes -noZero 2>/dev/null); then
        set_reconstruction_verification_error \
            "foamListTimes could not read the reconstructed time directories"
        return 1
    fi

    while IFS= read -r timeName; do
        [[ -n "$timeName" ]] && rootTimeSet["$timeName"]=1
    done <<< "$rootTimesOutput"

    for timeName in "${reconstructionTimes[@]}"; do
        if [[ -z "${rootTimeSet[$timeName]+x}" ]]; then
            set_reconstruction_verification_error \
                "reconstructed time '$timeName' is missing"
            return 1
        fi
    done

    collect_openfoam_processor_dirs
    currentProcessorDirs=("${collectedProcessorDirs[@]}")
    for processorDir in "${currentProcessorDirs[@]}"; do
        currentProcessorDirSet["$processorDir"]=1
    done

    if [[ ${#currentProcessorDirs[@]} -ne ${#reconstructionProcessorDirs[@]} ]]; then
        set_reconstruction_verification_error \
            "the processor storage layout changed during reconstruction"
        return 1
    fi

    for processorDir in "${reconstructionProcessorDirs[@]}"; do
        if [[ -z "${currentProcessorDirSet[$processorDir]+x}" \
            || -L "$processorDir" \
            || "$(stat -Lc '%d:%i' -- "$processorDir" 2>/dev/null)" \
                != "${reconstructionProcessorDirState[$processorDir]}" ]]; then
            set_reconstruction_verification_error \
                "processor storage '$processorDir' changed during reconstruction"
            return 1
        fi
    done

    for logicalPath in "${reconstructionObjects[@]}"; do
        destination=$(reconstructed_object_path "$logicalPath" 2>/dev/null || true)
        if [[ -z "$destination" || ! -s "$destination" || -L "$destination" ]]; then
            set_reconstruction_verification_error \
                "reconstructed object '$logicalPath' is missing, empty, or a symbolic link"
            return 1
        fi

        destinationClass=$(foam_file_class "$destination")
        if [[ -z "$destinationClass" ]]; then
            set_reconstruction_verification_error \
                "could not read the FoamFile class from '$destination'"
            return 1
        fi

        if [[ "${reconstructionExpectedClass[$logicalPath]}" != "__collated__" \
            && "$destinationClass" != "${reconstructionExpectedClass[$logicalPath]}" ]]; then
            set_reconstruction_verification_error \
                "class mismatch for '$logicalPath' (${reconstructionExpectedClass[$logicalPath]} -> $destinationClass)"
            return 1
        fi

        # Existing fields must have been refreshed by this reconstruction.
        # Mesh and uniform objects can legitimately be retained unchanged.
        if [[ -n "${reconstructionBeforeState[$logicalPath]}" \
            && "$logicalPath" != */polyMesh/* \
            && "$logicalPath" != */uniform/* ]]; then
            beforeState=${reconstructionBeforeState[$logicalPath]}
            afterState=$(reconstructed_object_state "$logicalPath" || true)
            if [[ -z "$afterState" || "$afterState" == "$beforeState" ]]; then
                set_reconstruction_verification_error \
                    "existing object '$logicalPath' was not refreshed"
                return 1
            fi
        fi
    done

    latestTime=${reconstructionTimes[$(( ${#reconstructionTimes[@]} - 1 ))]}
    checkMeshArgs=(-time "$latestTime")
    if [[ "$reconstructAllRegions" == true ]]; then
        if openfoam_command_supports_option checkMesh -allRegions; then
            checkMeshArgs=(-allRegions "${checkMeshArgs[@]}")
            if ! checkMesh "${checkMeshArgs[@]}" \
                > log/log.verifyReconstruction 2>&1; then
                set_reconstruction_verification_error \
                    "checkMesh could not read all reconstructed regions at time '$latestTime'"
                return 1
            fi
        elif openfoam_command_supports_option checkMesh -region; then
            collect_reconstructed_region_names "$latestTime"
            : > log/log.verifyReconstruction
            if [[ -d constant/polyMesh || -d "$latestTime/polyMesh" ]]; then
                if ! checkMesh -time "$latestTime" \
                    >> log/log.verifyReconstruction 2>&1; then
                    set_reconstruction_verification_error \
                        "checkMesh could not read the reconstructed default region at time '$latestTime'"
                    return 1
                fi
                checkedRegionMesh=true
            fi
            for regionName in "${collectedRegionNames[@]}"; do
                if ! checkMesh -region "$regionName" -time "$latestTime" \
                    >> log/log.verifyReconstruction 2>&1; then
                    set_reconstruction_verification_error \
                        "checkMesh could not read reconstructed region '$regionName' at time '$latestTime'"
                    return 1
                fi
                checkedRegionMesh=true
            done
            if [[ "$checkedRegionMesh" != true ]]; then
                set_reconstruction_verification_error \
                    "no reconstructed region meshes were found for readability checks"
                return 1
            fi
        else
            set_reconstruction_verification_error \
                "checkMesh does not support multi-region verification in this OpenFOAM version"
            return 1
        fi
    elif ! checkMesh "${checkMeshArgs[@]}" > log/log.verifyReconstruction 2>&1; then
        set_reconstruction_verification_error \
            "checkMesh could not read reconstructed time '$latestTime'"
        return 1
    fi

    if grep -qE 'FOAM FATAL|Segmentation fault' \
        log/log.verifyReconstruction 2>/dev/null; then
        set_reconstruction_verification_error \
            "checkMesh reported a fatal error for reconstructed time '$latestTime'"
        return 1
    fi

    return 0
}

remove_verified_processor_dirs() {
    local processorDir processorName cleanupStage movedDir
    local -a movedProcessorDirs=()

    for processorDir in "${reconstructionProcessorDirs[@]}"; do
        if [[ ! -d "$processorDir" || -L "$processorDir" ]]; then
            echo "[WARN]  Processor storage changed before cleanup; preserving all remaining data." >&2
            return 1
        fi
    done

    cleanupStage=$(mktemp -d .runCase-processor-cleanup.XXXXXX) || {
        echo "[ERROR] Could not create the processor cleanup staging directory." >&2
        return 1
    }

    # Move the complete set first. On a normal case filesystem these renames are
    # atomic and do not duplicate the (potentially very large) processor data.
    for processorDir in "${reconstructionProcessorDirs[@]}"; do
        processorName=${processorDir#./}
        if mv -- "$processorDir" "$cleanupStage/$processorName"; then
            movedProcessorDirs+=("$processorName")
        else
            echo "[ERROR] Could not stage '$processorDir' for cleanup; rolling back." >&2
            for movedDir in "${movedProcessorDirs[@]}"; do
                mv -- "$cleanupStage/$movedDir" "./$movedDir" 2>/dev/null || true
            done
            rmdir -- "$cleanupStage" 2>/dev/null || true
            return 1
        fi
    done

    if ! rm -rf -- "$cleanupStage"; then
        echo "[ERROR] Could not fully remove verified processor data." >&2
        echo "        Any remaining data is preserved under '$cleanupStage'."
        return 1
    fi

    return 0
}

# Read-only preflight. Python handles numeric times and JSON; OpenFOAM reads
# dictionaries with function entries disabled, so plans cannot execute code.
preflight() {
    python3 - "$mode" "$customNP" "$allowClean" "$keepProcessors" "$outputFormat" "${receiptActive:-false}" <<'PY'
import json, math, os, re, shutil, subprocess, sys
from pathlib import Path
mode, override, allow, keep, fmt, owns_lock = sys.argv[1:]
root = Path.cwd()
plan = dict(interfaceVersion=1, case=str(root), mode=mode, ok=False,
            requiresConfirmation=False, warnings=[])
def die(code, symbol, message):
    plan.update(error=symbol, message=message, exitCode=code)
    if fmt == 'json': print(json.dumps(plan))
    print(f'RUNCASE_ERROR={symbol}: {message}\nCase: {root}', file=sys.stderr)
    sys.exit(code)
def value(path, entry):
    if not shutil.which('foamDictionary'):
        die(15, 'ENVIRONMENT_MISSING', 'Source OpenFOAM: foamDictionary is unavailable.')
    result = subprocess.run(['foamDictionary', str(path), '-disableFunctionEntries', '-entry', entry, '-value'],
                            capture_output=True, text=True)
    if result.returncode:
        die(15, 'INVALID_DICTIONARY', f'Cannot read {entry} from {path} with function entries disabled; resolve included/generated values first. {result.stderr.strip()}')
    answer = result.stdout.strip().rstrip(';')
    if '#' in answer or '$' in answer:
        die(15, 'INVALID_DICTIONARY', f'{path}:{entry} requires executable or unexpanded dictionary entries. Provide a resolved value before running runCase.')
    return answer
def times(path):
    result = []
    for d in path.iterdir():
        if d.is_dir() and re.fullmatch(r'[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?', d.name):
            n = float(d.name)
            if math.isfinite(n): result.append((n, d.name))
    return sorted(result)
def fields(path):
    # Inventory all initialized volume/surface/point fields, including regions.
    result = set()
    if not path.is_dir(): return result
    import gzip
    for f in path.rglob('*'):
        if not f.is_file() or f.is_symlink() or 'polyMesh' in f.parts: continue
        try:
            opener = gzip.open if f.suffix == '.gz' else open
            with opener(f, 'rb') as stream: header = stream.read(16384)
        except OSError: continue
        if re.search(rb'\bclass\s+(?:vol|surface|point)\w*Field\s*;', header):
            result.add(str(f.relative_to(path)).removesuffix('.gz'))
    return result
if not (root/'system/controlDict').is_file(): die(15, 'INVALID_CASE', 'Missing system/controlDict.')
solver = value('system/controlDict', 'application')
np = override or (value('system/decomposeParDict', 'numberOfSubdomains')
                  if Path('system/decomposeParDict').is_file() else '1')
if not re.fullmatch('[1-9][0-9]*', np): die(14, 'INVALID_DECOMPOSITION', f'Invalid rank count: {np}')
np = int(np)
if override and not Path('system/decomposeParDict').is_file():
    die(14, 'INVALID_DECOMPOSITION', '--np requires an existing system/decomposeParDict.')
processors = sorted(p for p in root.iterdir() if re.fullmatch(r'processor\d+|processors(?:\d+(?:_\d+-\d+)?)?', p.name))
plan.update(solver=solver, ranks=np, decomposition=('none' if mode in ('clean', 'reconstruct') or np == 1 else ('create' if mode == 'new' or not processors else 'reuse')),
            reconstruction=np > 1 and mode != 'clean', processorCleanup=np > 1 and (mode == 'clean' or keep != 'true'),
            solverExecution=mode in ('new', 'continue'), cleanup=mode in ('new', 'clean'),
            log=str(root/'log/log.run'), latestTime=None)
end = value('system/controlDict', 'endTime')
try:
    end = float(end)
    if not math.isfinite(end): raise ValueError()
except ValueError: die(12, 'INVALID_RESTART', 'endTime must be finite and numeric.')
plan['endTime'] = end
existing = bool(processors or any(n != 0 for n, _ in times(root)))
plan['requiresConfirmation'] = (mode == 'clean' or mode == 'new' and existing) and allow != 'true'
if mode in ('continue', 'reconstruct') and processors:
    if any(p.is_symlink() or not p.is_dir() for p in processors):
        die(14, 'INVALID_DECOMPOSITION', 'Processor storage contains a symlink or non-directory.')
    names = {p.name for p in processors}
    uncollated = {f'processor{i}' for i in range(np)}
    if np <= 1 or names != uncollated and names != {f'processors{np}'}:
        die(14, 'INVALID_DECOMPOSITION', 'Processor layout does not match requested ranks. Split/legacy collated layouts require explicit review.')
if mode == 'continue':
    start = value('system/controlDict', 'startFrom')
    if start != 'latestTime': die(12, 'INVALID_RESTART', f'startFrom is {start}; continuation requires latestTime.')
    storage = processors or [root]
    latest = []
    expected = fields(root/'0.orig') | fields(root/'0')
    for base in storage:
        ts = times(base)
        if not ts: die(12, 'INVALID_RESTART', f'No restart time in {base}.')
        n, name = ts[-1]
        latest.append(n)
        destination = base/name
        if destination.is_symlink(): die(12, 'INVALID_RESTART', f'Restart time is a symlink: {destination}')
        # Collated wrappers do not identify field classes; validate filenames
        # against initialized fields, and let OpenFOAM validate their contents.
        required = expected | fields(base/'0')
        actual = fields(destination)
        if base.name.startswith('processors'):
            actual = {str(f.relative_to(destination)).removesuffix('.gz') for f in destination.rglob('*') if f.is_file() and not f.is_symlink() and f.stat().st_size}
        if not actual: die(12, 'INVALID_RESTART', f'No readable restart fields in {destination}.')
        missing = sorted(required - actual)
        if missing: die(12, 'INVALID_RESTART', f'Missing initialized fields in {destination}: {", ".join(missing)}')
        if not required: die(12, 'INVALID_RESTART', f'No initial field inventory in 0 or 0.orig for {base}; required restart fields cannot be checked.')
    if len(set(latest)) != 1: die(12, 'INVALID_RESTART', f'Processor latest times disagree: {latest}')
    plan['latestTime'] = latest[0]
    if end <= latest[0]: die(12, 'INVALID_RESTART', f'endTime {end} must exceed restart time {latest[0]}.')
    if np > 1 and not processors: plan['decomposition'] = 'create from latestTime'
if mode in ('new', 'continue') and not shutil.which(solver):
    die(15, 'ENVIRONMENT_MISSING', f'Solver {solver} is unavailable; source the correct OpenFOAM environment.')
lock = root/'.runCase/lock'
if lock.exists() and owns_lock != 'true':
    import fcntl
    try:
        with lock.open('r') as stream:
            fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        die(13, 'ALREADY_RUNNING', 'Another runCase owns this case; see .runCase/last-run.json.')
    except OSError as exc:
        die(15, 'PREPARATION_FAILED', f'Cannot inspect case lock: {exc}')
plan['lockStatus'] = 'owned' if owns_lock == 'true' else 'available'
if lock.exists() and owns_lock != 'true':
    try:
        receipt = json.loads((root/'.runCase/last-run.json').read_text())
        if receipt.get('state') == 'running':
            plan['warnings'].append('Previous receipt is unfinished, but its kernel lock is free; it will be replaced on launch.')
    except (OSError, ValueError): pass
plan['ok'] = True
if fmt == 'json': print(json.dumps(plan))
else:
    for key, val in plan.items(): print(f'{key}: {val}')
PY
}

write_receipt() {
    python3 - "$mode" "${solver:-}" "${nProcs:-1}" "${simStartT:-}" "${1:-running}" "${2:-}" "$errorSymbol" "$$" "${solver_pid:-}" "${invocationArgs[@]}" <<'PY'
import datetime, json, os, socket, sys, tempfile
from pathlib import Path
mode, solver, ranks, restart, state, status, error, pid, child = sys.argv[1:10]
p = Path('.runCase/last-run.json')
now = datetime.datetime.now(datetime.timezone.utc).isoformat()
data = {}
try:
    data = json.loads(p.read_text())
    if data.get('pid') != int(pid): data = {}
except (OSError, ValueError): pass
if not data: data['startedAt'] = now
# Preserve known fields if failure occurred before solver setup.
data.update(interfaceVersion=1, case=str(Path.cwd()), command=['runCase', *sys.argv[10:]], mode=mode, solver=solver,
            ranks=int(ranks), restartTime=restart or None, pid=int(pid),
            solverPid=int(child) if child else None, hostname=socket.gethostname(),
            state=state, exitStatus=int(status) if status else None,
            error=error or None, updatedAt=now, log=str(Path('log/log.run').resolve()))
fd, tmp = tempfile.mkstemp(dir=p.parent, prefix='.receipt-')
with os.fdopen(fd, 'w') as stream: json.dump(data, stream, indent=2); stream.write('\n')
os.replace(tmp, p)
PY
}

finish_receipt() {
    local status=$?
    if [[ "$receiptActive" == true ]]; then
        if [[ "$status" == 0 ]]; then write_receipt completed "$status";
        else write_receipt failed "$status"; fi
    fi
    if [[ "$status" != 0 && -z "$errorSymbol" ]]; then
        printf "RUNCASE_ERROR=UNEXPECTED_FAILURE: exited with status %s\n" "$status" >&2
    fi
    return "$status"
}

while [[ "$#" -gt 0 ]]
do
    case $1 in
        -h|--help)
            echo "Usage: runCase [MODE] [OPTIONS]"
            echo ""
            echo "Modes:"
            echo "  -n,  --new          Starts a new simulation. Cleans the case directory."
            echo "  -c,  --continue     Continues an existing simulation from the latestTime."
            echo "  -r,  --reconstruct  Performs manual reconstruction on a stopped parallel run."
            echo "  -clean, --clean     Cleans the case directory after cleanup approval."
            echo ""
            echo "Options:"
            echo "  -np <number>        Overrides numberOfSubdomains to use <number> processors."
            echo "  -q,  --quiet        Suppresses live display; does not approve prompts."
            echo "  --non-interactive  Never prompt; fail immediately if approval is needed."
            echo "  --allow-clean      Explicitly approve cleanup for --new or --clean."
            echo "  --plan, --dry-run  Validate and print actions without changing the case."
            echo "  --format=json     Machine-readable output for --plan."
            echo "  --version         Print version and interface version."
            echo "  --capabilities    Print supported automation features as JSON."
            echo "  -k,  --keep-processors"
            echo "                      Preserves processor data after successful reconstruction."
            echo "  -a,  --animate      Runs animateCase automatically when finished."
            echo "                      Optional animation flags: -s|--state <file>, --fps <num>,"
            echo "                                                --res <w> <h>, --field <name>"
            echo "  -b,  --batch        Explicitly enables batch mode. Recursively scans for nested cases."
            echo "  -P,  --jobs <num>   Number of concurrent jobs. Automatically enables batch mode."
            echo "  -h,  --help         Show this help message and exit."
            exit 0
            ;;
        --version) echo "runCase $RUNCASE_VERSION (interface $RUNCASE_INTERFACE_VERSION)"; exit 0 ;;
        --capabilities)
            printf '%s\n' '{"interfaceVersion":1,"version":"2.0.0","capabilities":["non-interactive","allow-clean","plan","json-plan","restart-validation","case-lock","launch-receipt"],"exitCodes":{"invalidArguments":2,"confirmationRequired":10,"cleanupRequired":11,"invalidRestart":12,"alreadyRunning":13,"invalidDecomposition":14,"preparationFailed":15,"meshFailed":20,"solverFailed":30,"reconstructionFailed":40,"batchFailed":50}}'
            exit 0 ;;
        --non-interactive) nonInteractive=true; originalArgs+=("$1") ;;
        --allow-clean) allowClean=true; originalArgs+=("$1") ;;
        --plan|--dry-run) planOnly=true ;;
        --format=*) outputFormat="${1#*=}" ;;
        -n|--new) set_mode new; originalArgs+=("$1") ;;
        --force-new) set_mode new; forceNew=true; originalArgs+=("$1") ;;
        --batch-new-if-empty) set_mode new; batchNewIfEmpty=true ;;
        -c|--continue) set_mode continue; originalArgs+=("$1") ;;
        -r|--reconstruct) set_mode reconstruct; originalArgs+=("$1") ;;
        -clean|--clean) set_mode clean; originalArgs+=("$1") ;;
        -q|--quiet) quiet=true; originalArgs+=("$1") ;;
        -k|--keep-processors) keepProcessors=true; originalArgs+=("$1") ;;
        -a|--animate) animate=true ;;
        -s|--state|--field)
            [[ $# -ge 2 && "$2" != -* ]] || fail 2 INVALID_ARGUMENTS "$1 requires a value."
            animArgs+=("$1" "$2"); shift ;;
        --fps)
            [[ $# -ge 2 && "$2" =~ ^[1-9][0-9]*$ ]] || fail 2 INVALID_ARGUMENTS "--fps requires a positive integer."
            animArgs+=("$1" "$2"); shift ;;
        --res)
            [[ $# -ge 3 && "$2" =~ ^[1-9][0-9]*$ && "$3" =~ ^[1-9][0-9]*$ ]] || fail 2 INVALID_ARGUMENTS "--res requires two positive integers."
            animArgs+=("$1" "$2" "$3"); shift 2 ;;
        -b|--batch) isBatch=true ;;
        -np|--np)
            if [[ "$#" -lt 2 ]] || ! [[ "$2" =~ ^[1-9][0-9]*$ ]]
            then
                fail 2 INVALID_ARGUMENTS "-np requires a positive integer argument."
            fi
            customNP="$2"
            originalArgs+=("$1" "$2")
            shift
            ;;
        -P|--jobs)
            if [[ "$#" -lt 2 ]] || ! [[ "$2" =~ ^[1-9][0-9]*$ ]]
            then
                fail 2 INVALID_ARGUMENTS "-P requires a positive integer argument."
            fi
            batchJobs="$2"
            isBatch=true
            shift
            ;;

        *)
            if [[ "$1" != -* ]]; then
                batchCases+=("$1")
                isBatch=true
            else
                fail 2 INVALID_ARGUMENTS "Unknown parameter: $1"
            fi
            ;;
    esac
    shift
done

[[ "$outputFormat" == text || "$outputFormat" == json ]] || fail 2 INVALID_ARGUMENTS "Use --format=text or --format=json."
[[ "$outputFormat" != json || "$planOnly" == true ]] || fail 2 INVALID_ARGUMENTS "--format=json requires --plan."
[[ ${#animArgs[@]} -eq 0 || "$animate" == true ]] || fail 2 INVALID_ARGUMENTS "Animation options require --animate."
[[ -n "$mode" ]] || fail 2 INVALID_ARGUMENTS "Choose --new, --continue, --reconstruct, or --clean."
[[ "$allowClean" == false || "$mode" == new || "$mode" == clean ]] || fail 2 INVALID_ARGUMENTS "--allow-clean requires --new or --clean."
# Legacy private flag still counts as explicit cleanup approval.
[[ "$forceNew" == false ]] || allowClean=true
# Never draw a live terminal UI into a service journal or pipeline.
[[ -t 1 ]] || quiet=true

if [[ ${#batchCases[@]} -eq 0 && ! -f "system/controlDict" ]]; then
    isBatch=true
fi


if [[ "$isBatch" == false ]]; then
    if [[ "$planOnly" == true ]]; then
        preflight
        exit $?
    fi
    # Validate first without changing the case. Lock and validate again before
    # mutation to prevent concurrent runCase invocations passing the same check.
    preflight >/dev/null || exit $?
    if [[ "$mode" == new ]] && case_has_simulation_data .; then
        [[ "$batchNewIfEmpty" != true ]] || fail 11 CLEANUP_REQUIRED "Unapproved simulation data appeared while this batch case was queued."
        if [[ "$allowClean" != true ]]; then
            confirm_action 11 CLEANUP_REQUIRED "Existing result data would be deleted. Re-run with --allow-clean if intended."
            allowClean=true
        fi
    fi
    if [[ "$mode" == clean && "$allowClean" != true ]]; then
        confirm_action 11 CLEANUP_REQUIRED "--clean deletes case data. Re-run with --allow-clean if intended."
        allowClean=true
    fi
    command -v flock >/dev/null || fail 15 ENVIRONMENT_MISSING "flock is required for case locking."
    [[ ! -L .runCase ]] || fail 15 INVALID_CASE ".runCase must not be a symlink."
    mkdir -p .runCase || fail 15 PREPARATION_FAILED "Cannot create .runCase."
    [[ ! -L .runCase/lock ]] || fail 15 INVALID_CASE ".runCase/lock must not be a symlink."
    exec {caseLockFd}>>.runCase/lock || fail 15 PREPARATION_FAILED "Cannot open case lock."
    flock -n "$caseLockFd" || fail 13 ALREADY_RUNNING "Another runCase owns this case; see .runCase/last-run.json."
    # The kernel releases flock on process exit. Never unlink its inode.
    receiptActive=true
    preflight >/dev/null || exit $?
    trap finish_receipt EXIT
    write_receipt running || fail 15 PREPARATION_FAILED "Cannot write launch receipt."
fi

if [[ "$isBatch" == true ]]; then
    if [[ "$planOnly" != true ]]; then
        echo "runCase Batch Manager"
    fi
    
    if [[ ${#batchCases[@]} -eq 0 ]]; then
        batchCases=(".")
    fi

    validCases=()
    for c in "${batchCases[@]}"; do
        if [[ -d "$c" ]]; then
            if [[ -f "$c/system/controlDict" ]]; then
                validCases+=("$(realpath "$c")")
            else
                echo "[INFO]  Searching for cases inside '$c'..." >&2
                while IFS= read -r foundCase; do
                    if [[ -n "$foundCase" ]]; then
                        validCases+=("$foundCase")
                    fi
                done < <(python3 -c "import os,sys; b=os.path.abspath(sys.argv[1]); [d.clear() if r[len(b):].count(os.sep)>=3 else (print(r) or d.clear()) if 'system' in d and os.path.isfile(os.path.join(r,'system','controlDict')) else None for r,d,f in os.walk(b)]" "$c" 2>/dev/null)
            fi
        else
            echo "[WARN]  Skipping '$c' (not a directory)" >&2
        fi
    done

    # Remove duplicates and sort naturally by basename
    if [[ ${#validCases[@]} -gt 0 ]]; then
        # Remove exact duplicates first
        mapfile -t validCases < <(printf "%s\n" "${validCases[@]}" | sort -u)
        # Then sort naturally by basename
        mapfile -t validCases < <(
            for c in "${validCases[@]}"; do
                echo "$(basename "$c")|$c"
            done | sort -t '|' -k 1,1 -V | cut -d '|' -f 2-
        )
    fi
    
    if [[ ${#validCases[@]} -eq 0 ]]; then
        fail 15 INVALID_CASE "No valid case directories provided for batch execution."
    fi
    
    if [[ "$nonInteractive" == true && "$animate" == true && ${#validCases[@]} -gt 1 ]]; then
        fail 10 CONFIRMATION_REQUIRED "animateCase prompts for multi-case rendering; omit --animate and render separately."
    fi
    if [[ "$planOnly" == true ]]; then
        planStatus=0
        for c in "${validCases[@]}"; do
            (cd "$c" && preflight) || planStatus=$?
        done
        exit "$planStatus"
    fi
    echo ""
    echo "[INFO]  Mode              : $mode"
    if [[ -n "$customNP" ]]; then
        echo "[INFO]  Parallel (MPI)    : $customNP cores per case"
    else
        echo "[INFO]  Parallel (MPI)    : Defined by decomposeParDict"
    fi
    echo "[INFO]  Batch Jobs (-P)   : $batchJobs"
    echo "[INFO]  Total Cases       : ${#validCases[@]}"
    
    if [[ "$mode" == "new" ]]; then
        casesWithData=()
        for c in "${validCases[@]}"; do
            if case_has_simulation_data "$c"; then
                casesWithData+=("$c")
            fi
        done
        
        if [[ ${#casesWithData[@]} -gt 0 ]]; then
            echo ""
            echo "[WARN]  Existing simulation data detected in the following cases:" >&2
            for c in "${casesWithData[@]}"; do
                echo "          - $(basename "$c")"
            done
            if [[ "$allowClean" != true ]]; then
                confirm_action 11 CLEANUP_REQUIRED "Existing simulation data detected. Delete and restart? Use --allow-clean only if intended."
            fi

            # Approval is recorded per case. Cases that were empty retain a
            # fail-closed worker guard in case data appears while they wait.
            for c in "${casesWithData[@]}"; do
                batchCleanupApproved["$c"]=true
            done
        fi
    fi
    
    if [[ "$mode" == clean && "$allowClean" != true ]]; then
        confirm_action 11 CLEANUP_REQUIRED "--clean will delete data in all selected cases. Use --allow-clean if intended."
        originalArgs+=(--allow-clean)
    fi
    echo ""
    echo "[INFO]  Cases to execute:"
    for c in "${validCases[@]}"; do
        echo "          - $(basename "$c")"
    done
    echo ""
    if [[ "$nonInteractive" != true ]]; then
        confirm_action 10 CONFIRMATION_REQUIRED "Proceed with batch execution?"
    fi
    echo ""
    
    states=()
    pids=()
    endTimes=()
    case_progress=()
    for ((i=0; i<${#validCases[@]}; i++)); do 
        states[$i]=0
        pids[$i]=""
        c_dir="${validCases[$i]}"
        et=$(grep "^[[:space:]]*endTime" "$c_dir/system/controlDict" 2>/dev/null | awk '{print $2}' | sed 's/;//')
        endTimes[$i]="$et"
        case_progress[$i]=""
    done
    
    running_jobs=0
    next_job=0
    spin_chars=("/" "—" "\\" "|")
    spin_idx=0
    loop_tick=0
    if [[ "$quiet" == false ]]; then
        # Enter alternate screen buffer
        tput smcup 2>/dev/null || echo -en "\033[?1049h"
        
        # Disable terminal echo to prevent keyboard input from breaking the UI layout
        # Also hide the cursor for better aesthetics
        trap 'interrupt_batch 130' INT
        trap 'interrupt_batch 143' TERM
        stty -echo 2>/dev/null
        echo -en "\033[?25l\033[?7l"
    else
        trap 'interrupt_batch 130' INT
        trap 'interrupt_batch 143' TERM
    fi
    
    while true; do
        for i in "${!validCases[@]}"; do
            if [[ "${states[$i]}" == 1 ]]; then
                if ! kill -0 "${pids[$i]}" 2>/dev/null; then
                    wait "${pids[$i]}"
                    exit_status=$?
                    if [[ $exit_status -eq 0 ]]; then
                        states[$i]=2
                    else
                        states[$i]=3
                        c_dir="${validCases[$i]}"
                        local_log=$(\ls -t "$c_dir"/log/log.* 2>/dev/null | head -n 1)
                        if [[ -z "$local_log" ]]; then local_log="$c_dir/log/log.run"; fi
                        if [[ -f "$local_log" && -n "${endTimes[$i]}" && "${endTimes[$i]}" != "0" ]]; then
                            prog=$(tail -n 500 "$local_log" 2>/dev/null | awk -v end="${endTimes[$i]}" '
                                /^Time = /{t=$3}
                                END {
                                    if(t != "" && end > 0) {
                                        p=(t/end)*100;
                                        if(p>100) p=100;
                                        if(p<0) p=0;
                                        printf "%.1f", p
                                    }
                                }')
                            if [[ -n "$prog" ]]; then
                                case_progress[$i]=" ($prog%)"
                            else
                                case_progress[$i]=""
                            fi
                        fi
                    fi
                    ((running_jobs--))
                fi
            fi
        done
        
        while [[ $running_jobs -lt $batchJobs ]] && [[ $next_job -lt ${#validCases[@]} ]]; do
            c_dir="${validCases[$next_job]}"
            workerArgs=("${originalArgs[@]}" --non-interactive)
            if [[ "$mode" == "new" ]]; then
                for i in "${!workerArgs[@]}"; do
                    if [[ "${workerArgs[$i]}" == "-n" \
                        || "${workerArgs[$i]}" == "--new" ]]; then
                        if [[ "${batchCleanupApproved[$c_dir]:-false}" == true ]]; then
                            workerArgs[$i]="--new"
                            workerArgs+=("--allow-clean")
                        else
                            workerArgs[$i]="--batch-new-if-empty"
                        fi
                    fi
                done
            fi
            if [[ "$quiet" == false ]]; then workerArgs+=("--quiet"); fi
            
            mkdir -p "$c_dir/log"
            (cd "$c_dir" && "$scriptPath" "${workerArgs[@]}" > log/.batch_worker.log 2>&1) &
            pids[$next_job]=$!
            states[$next_job]=1
            
            ((running_jobs++))
            ((next_job++))
        done
        
        spin_char="${spin_chars[$spin_idx]}"
        spin_idx=$(( (spin_idx + 1) % 4 ))
        
        if [[ "$quiet" == false ]]; then
            # Move to top-left of alternate screen
            printf "\\033[H"
            
            echo "================================================================================"
            printf " runCase Batch Manager - Running %d cases (Jobs: %s)\n" "${#validCases[@]}" "$batchJobs"
            echo "================================================================================"
            echo ""
            
            max_lines=$(tput lines 2>/dev/null || echo 24)
            max_cases=$(( max_lines - 6 ))
            if [[ $max_cases -lt 5 ]]; then max_cases=5; fi
            
            printed_cases=0
            
            for i in "${!validCases[@]}"; do
                if [[ $printed_cases -ge $max_cases && ${#validCases[@]} -gt $max_cases ]]; then
                    printf "\\033[2K... and %d more cases\n" $(( ${#validCases[@]} - printed_cases ))
                    ((printed_cases++))
                    break
                fi
                
                c_name=$(basename "${validCases[$i]}")
                c_dir="${validCases[$i]}"
                
                if [[ "${states[$i]}" == 1 ]]; then
                    if [[ $((loop_tick % 4)) -eq 0 ]]; then
                        local_log=$(\ls -t "$c_dir"/log/log.* 2>/dev/null | head -n 1)
                        if [[ -z "$local_log" ]]; then local_log="$c_dir/log/log.run"; fi
                        if [[ -f "$local_log" && -n "${endTimes[$i]}" && "${endTimes[$i]}" != "0" ]]; then
                            prog=$(tail -n 500 "$local_log" 2>/dev/null | awk -v end="${endTimes[$i]}" '
                                /^Time = /{t=$3}
                                END {
                                    if(t != "" && end > 0) {
                                        p=(t/end)*100;
                                        if(p>100) p=100;
                                        if(p<0) p=0;
                                        printf "%.1f", p
                                    }
                                }')
                            if [[ -n "$prog" ]]; then
                                case_progress[$i]=" ($prog%)"
                            else
                                case_progress[$i]=""
                            fi
                        fi
                    fi
                fi
    
                if [[ "${states[$i]}" == 0 ]]; then status_text="Queued"; fi
                if [[ "${states[$i]}" == 1 ]]; then
                    if [[ -f "$c_dir/log/.batch_stage" ]]; then
                        local_stage=$(<"$c_dir/log/.batch_stage")
                    else
                        local_stage="Running"
                    fi
                    status_text="[$spin_char] ${local_stage}${case_progress[$i]}"
                fi
                if [[ "${states[$i]}" == 2 ]]; then status_text="Done"; fi
                if [[ "${states[$i]}" == 3 ]]; then status_text="Crashed${case_progress[$i]}"; fi
                
                printf "\\033[2K%-40s : %s\n" "$c_name" "$status_text"
                ((printed_cases++))
            done
            echo -en "\\033[J" # Clear any leftover lines below
        fi
        
        all_done=true
        for st in "${states[@]}"; do
            if [[ "$st" -lt 2 ]]; then all_done=false; break; fi
        done
        if [[ "$all_done" == true ]]; then break; fi
        
        ((loop_tick++))
        sleep 0.5
    done
    
    if [[ "$quiet" == false ]]; then
        stty echo 2>/dev/null
        # Exit alternate screen
        tput rmcup 2>/dev/null || echo -en "\033[?1049l"
        echo -en "\033[?25h\033[?7h"
        
        echo ""
        echo "================================================================================"
        echo " Batch Execution Complete!"
        echo "================================================================================"
        for i in "${!validCases[@]}"; do
            c_name=$(basename "${validCases[$i]}")
            if [[ "${states[$i]}" == 2 ]]; then status_text="Done"; fi
            if [[ "${states[$i]}" == 3 ]]; then status_text="Crashed"; fi
            printf "%-40s : %s\n" "$c_name" "$status_text"
        done
        echo ""
    fi
    trap - INT TERM
    
    echo ""
    echo "================================================================================"
    echo " Batch Execution Complete!"
    echo "================================================================================"
    
    if [[ "$animate" == true ]]; then
        echo ""
        echo "[RUN]   Rendering animations for all batch cases..."
        
        if [[ ${#validCases[@]} -gt 0 ]]; then
            # Determine the same output directory that animateCase will select.
            # A single-case batch writes into the case directory; multi-case
            # batches use the first available Animations, Animations 1, etc.
            if [[ ${#validCases[@]} -eq 1 ]]; then
                animationOutDir="${validCases[0]}"
            else
                animationOutDir="$(pwd)/Animations"
                animationDirIndex=1
                while [[ -e "$animationOutDir" ]]; do
                    animationOutDir="$(pwd)/Animations $animationDirIndex"
                    ((animationDirIndex++))
                done
            fi

            animateCase -P "$batchJobs" "${animArgs[@]}" "${validCases[@]}" || fail 50 BATCH_FAILED "Batch animation failed."
            
            # Rename crashed cases
            for i in "${!validCases[@]}"; do
                if [[ "${states[$i]}" == 3 ]]; then
                    c_name=$(basename "${validCases[$i]}")
                    animationFile="$animationOutDir/${c_name}.avi"
                    crashedAnimationFile="$animationOutDir/${c_name}_Crashed.avi"
                    if [[ -f "$animationFile" ]]; then
                        if [[ -e "$crashedAnimationFile" || -L "$crashedAnimationFile" ]]; then
                            crashedAnimationIndex=1
                            while [[ -e "$animationOutDir/${c_name}_Crashed_${crashedAnimationIndex}.avi" \
                                || -L "$animationOutDir/${c_name}_Crashed_${crashedAnimationIndex}.avi" ]]; do
                                ((crashedAnimationIndex++))
                            done
                            crashedAnimationFile="$animationOutDir/${c_name}_Crashed_${crashedAnimationIndex}.avi"
                        fi
                        if ! mv -n -- "$animationFile" "$crashedAnimationFile"; then
                            echo "[WARN]  Could not preserve crashed animation '$animationFile'." >&2
                        elif [[ -e "$animationFile" || -L "$animationFile" ]]; then
                            echo "[WARN]  Crash animation destination appeared concurrently; '$animationFile' was preserved." >&2
                        fi
                    fi
                fi
            done
        fi
    fi
    for state in "${states[@]}"; do
        [[ "$state" != 3 ]] || fail 50 BATCH_FAILED "One or more cases failed; see each case's log/.batch_worker.log."
    done
    exit 0
fi



if [[ "$mode" == "clean" ]]
then
    [[ "$allowClean" == true ]] || confirm_action 11 CLEANUP_REQUIRED "--clean deletes case data. Re-run with --allow-clean if intended."
    mkdir -p log || fail 15 PREPARATION_FAILED "Cannot create log directory."
    echo ""
    printf "[CLEAN] %-40s\n" "Cleaning case directory"
    find log/ -type f ! -name 'log.checkMesh' -delete || fail 15 PREPARATION_FAILED "Could not clean log files."
    foamListTimes -rm || fail 15 PREPARATION_FAILED "foamListTimes cleanup failed."
    if ! remove_openfoam_processor_dirs; then
        fail 15 PREPARATION_FAILED "Could not remove all recognized OpenFOAM processor directories."
    fi
    if [[ -d "0.orig" ]]; then
            rm -rf -- 0 && cp -r -- 0.orig 0 || fail 15 PREPARATION_FAILED "Could not restore 0.orig."
        fi
    if [[ -f system/setFieldsDict ]]; then
            setFields > log/log.setFields 2>&1 || fail 15 PREPARATION_FAILED "setFields failed; see log/log.setFields."
        fi
    echo ""
    echo "[DONE]  Cleaning complete."
    exit 0
fi

# Detect OpenFOAM Environment
ofVersion="${WM_PROJECT_VERSION:-Unknown}"

solver=$(foamDictionary system/controlDict -disableFunctionEntries -entry application -value)
if ! command -v "$solver" &> /dev/null
then
    fail 15 ENVIRONMENT_MISSING "Solver ${solver} not found in PATH."
fi

# Update decomposeParDict if customNP is set
if [[ -n "$customNP" ]]
then
    if [[ -f "system/decomposeParDict" ]]
    then
        foamDictionary system/decomposeParDict -disableFunctionEntries -entry numberOfSubdomains -set "$customNP" >/dev/null || fail 14 INVALID_DECOMPOSITION "Cannot update rank count."
    else
        fail 14 INVALID_DECOMPOSITION "system/decomposeParDict not found; cannot change ranks."
    fi
fi

# Detect Parallel Configuration
runParallel=false
nProcs=1

if [[ -f "system/decomposeParDict" ]]
then
    parsedProcs=$(foamDictionary system/decomposeParDict -disableFunctionEntries -entry numberOfSubdomains -value)
    if [[ "$parsedProcs" =~ ^[0-9]+$ ]] && [[ "$parsedProcs" -gt 0 ]]
    then
        nProcs="$parsedProcs"
        if [[ "$nProcs" -gt 1 ]]
        then
            runParallel=true
        fi
    else
        fail 14 INVALID_DECOMPOSITION "Could not read a valid numberOfSubdomains."
    fi
fi

# Detect Dynamic Mesh Configuration
isDynamicMesh=false
meshTypeStr="Static"
while IFS= read -r -d '' dynamicMeshDict; do
    meshType=$(grep "^[[:space:]]*dynamicFvMesh" "$dynamicMeshDict" \
        | awk '{print $2}' | sed 's/;//')
    if [[ -n "$meshType" ]] && [[ "$meshType" != "staticFvMesh" ]]
    then
        isDynamicMesh=true
        meshTypeStr="Dynamic (AMR)"
        break
    fi
done < <(
    find constant -mindepth 1 -maxdepth 2 -type f \
        -name dynamicMeshDict -print0 2>/dev/null
)

endTime=$(foamDictionary system/controlDict -disableFunctionEntries -entry endTime -value)
writeInterval=$(foamDictionary system/controlDict -disableFunctionEntries -entry writeInterval -value)

# --- Start Time Detection ---
simStartT="0"
if [[ "$mode" == "continue" ]] || [[ "$mode" == "reconstruct" ]]
then
    collect_openfoam_processor_dirs
    if [[ ${#collectedProcessorDirs[@]} -gt 0 ]]; then
        simStartT=$(foamListTimes -processor -latestTime 2>/dev/null)
    else
        simStartT=$(foamListTimes -latestTime 2>/dev/null)
    fi
    [[ -n "$simStartT" ]] || simStartT=0
fi

# --- Mesh Status and Cell Count ---
mkdir -p log || fail 15 PREPARATION_FAILED "Cannot create log directory."
if [[ "$mode" != "reconstruct" ]]
then
    printf "[INIT]  %-25s : Checking Mesh" "Mesh Check"
    echo "Checking Mesh" > log/.batch_stage
    meshCommand=(checkMesh -time 0)
    if [[ "$mode" == continue ]]; then
        collect_openfoam_processor_dirs
        if [[ "$runParallel" == true && ${#collectedProcessorDirs[@]} -gt 0 ]]; then
            meshCommand=(mpirun -np "$nProcs" checkMesh -parallel -latestTime)
        else
            meshCommand=(checkMesh -latestTime)
        fi
    fi
    if [[ -f constant/regionProperties ]]; then meshCommand+=(-allRegions); fi
    "${meshCommand[@]}" > log/log.checkMesh 2>&1 &
    check_pid=$!
    
    # Trap SIGINT/SIGTERM to kill background checkMesh
    trap 'interrupt_child 130 "$check_pid"' INT
    trap 'interrupt_child 143 "$check_pid"' TERM
    
    dots="."
    while kill -0 "$check_pid" 2>/dev/null
    do
        sleep 1
        if [[ "$quiet" == false ]]; then printf "\r\033[2K[INIT]  %-25s : Checking Mesh%s" "Mesh Check" "$dots"; fi
        case "$dots" in
            "")    dots="." ;;
            ".")   dots=".." ;;
            "..")  dots="..." ;;
            "...") dots="" ;;
        esac
    done
    
    wait "$check_pid" || fail 20 MESH_FAILED "checkMesh failed; see log/log.checkMesh."
    
    # Restore traps
    trap - SIGINT SIGTERM
    
    if grep -iq "Mesh OK" log/log.checkMesh
    then
        meshStatus="OK"
    else
        meshStatus="Failed"
    fi
    if [[ "$quiet" == false ]]; then echo -en "\r\033[2K"; else echo; fi
elif [[ -f log/log.checkMesh ]]
then
    meshStatus=$(grep -iq "Mesh OK" log/log.checkMesh && echo "OK" || echo "Failed")
else
    meshStatus="N/A"
fi

if [[ "$mode" != reconstruct && "$meshStatus" != OK ]]; then
    fail 20 MESH_FAILED "Mesh check failed; see log/log.checkMesh."
fi

if [[ -f log/log.checkMesh ]]; then
    cellCountRaw=$(grep "cells:" log/log.checkMesh | head -n 1 | awk '{print $2}')
else
    cellCountRaw="0"
fi
if [[ -z "$cellCountRaw" ]]; then cellCountRaw="0"; fi
cellCount=$(echo "$cellCountRaw" | sed ':a;s/\B[0-9]\{3\}\>/ &/g;ta')

if [[ "$runParallel" == true ]]
then
    if [[ "$cellCountRaw" =~ ^[0-9]+$ ]] && [[ "$nProcs" =~ ^[0-9]+$ ]] && [[ "$nProcs" -gt 0 ]]
    then
        cellsPerProcRaw=$(( cellCountRaw / nProcs ))
    else
        cellsPerProcRaw="0"
    fi
    cellsPerProc=$(echo "$cellsPerProcRaw" | sed ':a;s/\B[0-9]\{3\}\>/ &/g;ta')
fi

# --- Aligned Setup Info ---
print_case_info() {
    echo "================================================================================"
    echo ""
    printf "[INFO]  %-25s : %s\n" "Case Folder" "$(basename "$(pwd)")"
    printf "[INFO]  %-25s : %s\n" "OpenFOAM Version" "$ofVersion"
    printf "[INFO]  %-25s : %s\n" "Solver" "$solver"
    if [[ "$runParallel" == true ]]
    then
        printf "[INFO]  %-25s : Parallel (%s cores)\n" "Execution" "$nProcs"
    else
        printf "[INFO]  %-25s : Serial (1 core)\n" "Execution"
    fi
    printf "[INFO]  %-25s : %s s\n" "Target endTime" "$endTime"
    printf "[INFO]  %-25s : %s s\n" "Write Interval" "$writeInterval"
    printf "[INFO]  %-25s : %s\n" "Mesh Type" "$meshTypeStr"
    printf "[INFO]  %-25s : %s\n" "Mesh Status" "$meshStatus"
    local cellLabel="Cell Count"
    local coreLabel="Cells per Core"
    if [[ "$isDynamicMesh" == true ]]; then
        cellLabel="Initial Cell Count"
        coreLabel="Initial Cells per Core"
    fi

    printf "[INFO]  %-25s : %s\n" "$cellLabel" "$cellCount"
    if [[ "$runParallel" == true ]]
    then
        printf "[INFO]  %-25s : %s\n" "$coreLabel" "$cellsPerProc"
    fi
    echo ""
    printf "[INFO]  %-25s : %s s\n" "Starting from" "$simStartT"

}

print_case_info

# -----------------------------------------------------------------------------
# 2. Mode Specific Logic
# -----------------------------------------------------------------------------

if [[ "$mode" == "reconstruct" ]]
then
    echo ""
    echo "[INIT]  Starting manual reconstruction"
    echo ""
    
    if [[ "$runParallel" == false ]]
    then
        echo "[INFO]  Case configured for serial execution. No reconstruction required."
        exit 0
    fi
    
    collect_openfoam_processor_dirs
    if [[ ${#collectedProcessorDirs[@]} -eq 0 ]]
    then
        echo "[INFO]  No processor directories found. Case is already reconstructed or not decomposed."
        exit 0
    fi
else
    hasData=0
    if case_has_simulation_data .; then hasData=1; fi

    if [[ "$mode" == "new" ]]
    then
        if [[ "$hasData" -eq 1 ]] && [[ "$batchNewIfEmpty" == true ]]
        then
            fail 11 CLEANUP_REQUIRED "Unapproved simulation data appeared while this batch case was queued. No data was removed; review and retry."
        elif [[ "$hasData" -eq 1 ]] && [[ "$allowClean" == false ]]
        then
            echo ""
            printf "[WARN]  %-25s\n" "Existing simulation data detected." >&2
            confirm_action 11 CLEANUP_REQUIRED "Existing result data would be deleted by --new. Re-run with --allow-clean if intended."
        fi
        
        echo ""
        printf "[CLEAN] %-40s\n" "Cleaning case directory"
        find log/ -type f ! -name 'log.checkMesh' -delete || fail 15 PREPARATION_FAILED "Could not clean log files."
        foamListTimes -rm || fail 15 PREPARATION_FAILED "foamListTimes cleanup failed."
        if ! remove_openfoam_processor_dirs; then
            fail 15 PREPARATION_FAILED "Could not remove all recognized OpenFOAM processor directories."
        fi
        if [[ -d "0.orig" ]]; then
            rm -rf -- 0 && cp -r -- 0.orig 0 || fail 15 PREPARATION_FAILED "Could not restore 0.orig."
        fi
        if [[ -f system/setFieldsDict ]]; then
            setFields > log/log.setFields 2>&1 || fail 15 PREPARATION_FAILED "setFields failed; see log/log.setFields."
        fi
        echo ""
    fi

    # -----------------------------------------------------------------------------
    # 3. Execution and Monitoring
    # -----------------------------------------------------------------------------

    if [[ "$runParallel" == true ]]
    then
        collect_openfoam_processor_dirs
        if [[ ${#collectedProcessorDirs[@]} -eq 0 ]]
        then
            printf "[RUN]   Decomposing domain"
            echo "Decomposing" > log/.batch_stage
            decomposeArgs=()
            [[ "$mode" != continue ]] || decomposeArgs+=(-latestTime)
            decomposePar "${decomposeArgs[@]}" > log/log.decomposePar 2>&1 &
            decomp_pid=$!
            
            # Trap SIGINT/SIGTERM to kill background decomposePar
            trap 'interrupt_child 130 "$decomp_pid"' INT
            trap 'interrupt_child 143 "$decomp_pid"' TERM
            
            dots="."
            while kill -0 "$decomp_pid" 2>/dev/null
            do
                sleep 1
                if [[ "$quiet" == false ]]; then printf "\r\033[2K[RUN]   Decomposing domain%s" "$dots"; fi
                case "$dots" in
                    "")    dots="." ;;
                    ".")   dots=".." ;;
                    "..")  dots="..." ;;
                    "...") dots="" ;;
                esac
            done
            
            wait "$decomp_pid" || fail 14 INVALID_DECOMPOSITION "decomposePar failed; see log/log.decomposePar."
            
            # Restore traps
            trap - SIGINT SIGTERM
            
            if [[ "$quiet" == false ]]; then printf "\r\033[2K"; fi
            printf "[RUN]   Decomposing domain... Done\n"
        fi

        printf "[RUN]   Starting %s in parallel (%s cores)\n" "$solver" "$nProcs"
        echo "Running" > log/.batch_stage
        mpirun -np "$nProcs" "$solver" -parallel > log/log.run 2>&1 &
        solver_pid=$!
    else
        printf "[RUN]   Starting %s in serial\n" "$solver"
        echo "Running" > log/.batch_stage
        "$solver" > log/log.run 2>&1 &
        solver_pid=$!
    fi

    write_receipt running || fail 15 PREPARATION_FAILED "Cannot update launch receipt."

    # Intercept Ctrl+C and kill the background solver process
    trap 'interrupt_child 130 "$solver_pid"' INT
    trap 'interrupt_child 143 "$solver_pid"' TERM
    trap 'redraw_ui=true' SIGWINCH

    redraw_ui=false

    if [[ "$quiet" == false ]]; then echo -e "\n\n\n\n\n\n\n\n\n\n\n\n"; fi
    
    last_output=""

    while kill -0 "$solver_pid" 2>/dev/null
    do
        if [[ "$redraw_ui" == true && "$quiet" == false ]]; then
            clear
            print_case_info
            if [[ "$runParallel" == true ]]; then
                printf "[RUN]   Starting %s in parallel (%s cores)\n" "$solver" "$nProcs"
            else
                printf "[RUN]   Starting %s in serial\n" "$solver"
            fi
            echo -e "\n\n\n\n\n\n\n\n\n\n\n\n"
            
            if [[ "$last_output" != "WAITING" ]] && [[ -n "$last_output" ]]
            then
                temp="${last_output//[^$'\n']/}"
                num_lines=$(( ${#temp} + 1 ))
                echo -en "\033[${num_lines}A"
                while IFS= read -r line; do echo -e "\033[2K$line"; done <<< "$last_output"
            fi
            
            redraw_ui=false
        fi

        sleep 5
        if [[ "$quiet" == true ]]; then continue; fi
        
        # Check latest saved time step depending on execution mode
        if [[ "$runParallel" == true ]]
        then
            latestSaved=$(foamListTimes -processor -latestTime 2>/dev/null)
        else
            latestSaved=$(foamListTimes -latestTime 2>/dev/null)
        fi
        if [[ -z "$latestSaved" ]]; then latestSaved="0"; fi

        if [[ "$isDynamicMesh" == true ]]
        then
            latestCells=$(tac log/log.run 2>/dev/null | awk '
            tolower($0) ~ /^[[:space:]]*(number of cells|cells:)/ { c=$0; gsub(/[^0-9]/, "", c); print c; exit }
            /cells for refinement out of / { sub(/.*out of /, "", $0); c=$0; gsub(/[^0-9]/, "", c); print c; exit }
            /(Refined|Unrefined) from .* to / { sub(/.* to /, "", $0); sub(/ cells.*/, "", $0); c=$0; gsub(/[^0-9]/, "", c); print c; exit }
            ')
            if [[ -n "$latestCells" ]]; then
                currentCellCountRaw="$latestCells"
            else
                currentCellCountRaw="$cellCountRaw"
            fi
        else
            currentCellCountRaw="$cellCountRaw"
        fi
        currentCellCount=$(echo "$currentCellCountRaw" | sed ':a;s/\B[0-9]\{3\}\>/ &/g;ta')
        
        if [[ "$runParallel" == true ]]
        then
            if [[ "$currentCellCountRaw" =~ ^[0-9]+$ ]] && [[ "$nProcs" =~ ^[0-9]+$ ]] && [[ "$nProcs" -gt 0 ]]
            then
                currentCellsPerProcRaw=$(( currentCellCountRaw / nProcs ))
            else
                currentCellsPerProcRaw="0"
            fi
            currentCellsPerProc=$(echo "$currentCellsPerProcRaw" | sed ':a;s/\B[0-9]\{3\}\>/ &/g;ta')
        else
            currentCellsPerProc="N/A"
        fi

        output=$(tail -n 2000 log/log.run 2>/dev/null | awk -v end_time="$endTime" -v last_saved="$latestSaved" \
        -v curr_cells="$currentCellCount" -v curr_cpp="$currentCellsPerProc" \
        -v is_dynamic="$isDynamicMesh" -v is_parallel="$runParallel" '
        function fmt(val) {
            if (val == "N/A" || val == "") return "N/A";
            v = val + 0;
            abs_v = (v < 0) ? -v : v;
            if (abs_v >= 0.01 || abs_v == 0) {
                return sprintf("%.3f", v);
            } else {
                return sprintf("%.2e", v);
            }
        }
        
        function format_time(seconds) {
            if (seconds == "") return ""
            seconds = int(seconds)
            m = int(seconds / 60)
            s = int(seconds % 60)
            h = int(m / 60)
            m = int(m % 60)
            d = int(h / 24)
            h = int(h % 24)
            if (d > 0) return sprintf("%dd %dh %dm", d, h, m)
            else if (h > 0) return sprintf("%02d:%02d:%02d", h, m, s)
            else if (m > 0) return sprintf("00:%02d:%02d", m, s)
            else return sprintf("00:00:%02d", s)
        }
        
        BEGIN { tc=0; dtc=0; ec=0; c_mean="N/A"; c_max="N/A"; ic_mean="N/A"; ic_max="N/A"; cap_num=""; }
        
        /^Time = / { t[tc++] = $3 }
        /^deltaT = / { dt[dtc++] = $3 }
        /^ExecutionTime = / { exec[ec++] = $3 }
        
        /Courant Number/ && !/Interface/ {
            for(i=1; i<NF; i++) {
                if($i == "mean:") c_mean = $(i+1)
                if($i == "max:")  c_max  = $(i+1)
            }
        }
        /Interface Courant Number/ {
            for(i=1; i<NF; i++) {
                if($i == "mean:") ic_mean = $(i+1)
                if($i == "max:")  ic_max  = $(i+1)
            }
        }
        /Capillary Number/ {
            for(i=1; i<=NF; i++) {
                if($i ~ /Number:?/) {
                    if (i < NF) {
                        cap_num = $(i+1)
                    } else {
                        split($i, parts, ":")
                        cap_num = parts[2]
                    }
                    break
                }
            }
        }

        END {
            if (tc == 0 || ec == 0) {
                print "WAITING"
                exit
            }
            
            curr_t = t[tc-1]; curr_dt = dt[dtc-1]; curr_exec = exec[ec-1]
            idx = (tc > 11) ? tc - 11 : 0
            steps = tc - 1 - idx
            speed = (curr_exec > exec[idx]) ? (curr_t - t[idx]) / (curr_exec - exec[idx]) : 0
            iter_speed = (steps > 0) ? (curr_exec - exec[idx]) / steps : 0
            
            prog = (curr_t / end_time) * 100
            if (prog > 100) prog = 100; if (prog < 0) prog = 0
            eta_sec = (speed > 0 && end_time > curr_t) ? (end_time - curr_t) / speed : 0

            bar_len = 40; filled = int((prog / 100) * bar_len)
            bar = ""
            for(i=0; i<bar_len; i++) {
                if(i < filled) bar = bar "▓"
                else bar = bar "░"
            }

            elapsed_str = format_time(curr_exec)
            eta_str = format_time(eta_sec)

            printf "Progress                 : %s %.1f%%\n", bar, prog
            printf "Time (t)                 : %s s\n", fmt(curr_t)
            printf "Timestep (dt)            : %s s\n", fmt(curr_dt)
            printf "Latest Saved Timestep    : %s s\n", last_saved
            if (is_dynamic == "true") {
                printf "Cell Count               : %s\n", curr_cells
                if (is_parallel == "true") {
                    printf "Cells per Core           : %s\n", curr_cpp
                }
            }
            printf "Courant Number           : mean: %s max: %s\n", fmt(c_mean), fmt(c_max)
            printf "Interface Courant Number : mean: %s max: %s\n", fmt(ic_mean), fmt(ic_max)
            if (cap_num != "") {
                printf "Capillary Number         : %s\n", fmt(cap_num)
            }
            printf "Iteration Speed          : %.2f s/it\n", iter_speed
            if (speed > 0 && tc > 10) 
                printf "Elapsed                  : %s | ETA: %s\n", elapsed_str, eta_str
            else 
                printf "Elapsed                  : %s | ETA: Calculating...\n", elapsed_str
        }')

        if [[ "$quiet" == false ]]; then
            last_output="$output"
            if [[ "$output" != "WAITING" ]] && [[ -n "$output" ]]
            then
                temp="${output//[^$'\n']/}"
                num_lines=$(( ${#temp} + 1 ))
                echo -en "\033[${num_lines}A"
                while IFS= read -r line; do echo -e "\033[2K$line"; done <<< "$output"
            fi
        fi
    done

    wait "$solver_pid"
    exit_status=$?
    trap - INT TERM WINCH

    if [ $exit_status -ne 0 ]
    then
        echo ""
        printf "[ERROR] Solver terminated unexpectedly (Exit code: %s)\n" "$exit_status" >&2
        echo "------------------- LAST LOG ENTRIES -------------------"
        tail -n 25 log/log.run >&2
        echo "--------------------------------------------------------"
        fail 30 SOLVER_FAILED "Solver exited with status $exit_status; see log/log.run."
    fi
    echo ""
fi

# -----------------------------------------------------------------------------
# 4. Post-Processing
# -----------------------------------------------------------------------------
if [[ "$runParallel" == true ]]
then
    reconstructSuccess=true
    reconstructAllRegions=false
    reconstructionRegionArg=""

    fileHandlerArg=""
    collect_openfoam_processor_dirs
    for processorDir in "${collectedProcessorDirs[@]}"; do
        if [[ "${processorDir#./}" == processors* ]]; then
            fileHandlerArg="-fileHandler collated"
            break
        fi
    done

    if [[ -f constant/regionProperties ]]; then
        if ! openfoam_command_supports_option reconstructPar -allRegions; then
            reconstructSuccess=false
            echo ""
            printf "[ERROR] This OpenFOAM version cannot reconstruct all regions safely.\n" >&2
            printf "        Processor directories were preserved.\n"
        elif [[ "$isDynamicMesh" == true ]] \
            && ! openfoam_command_supports_option reconstructParMesh -allRegions; then
            reconstructSuccess=false
            echo ""
            printf "[ERROR] This OpenFOAM version cannot reconstruct all dynamic region meshes safely.\n" >&2
            printf "        Processor directories were preserved.\n"
        else
            reconstructAllRegions=true
            reconstructionRegionArg="-allRegions"
        fi
    fi

    if [[ "$isDynamicMesh" == true && "$reconstructSuccess" == true ]]
    then
        skipReconstructMesh=false
        if [[ -f "log/log.reconstructParMesh" && "log/log.reconstructParMesh" -nt "log/log.run" ]]; then
            if tail -n 5 log/log.reconstructParMesh 2>/dev/null | grep -q "^End"; then
                skipReconstructMesh=true
                
                # Verify that addressing files actually exist in the expected format
                if [[ -n "$fileHandlerArg" ]]; then
                    if ! find . -maxdepth 5 -path "./processors*/[0-9]*/polyMesh/pointProcAddressing" -print -quit 2>/dev/null | grep -q .; then
                        skipReconstructMesh=false
                    fi
                else
                    if ! find . -maxdepth 5 -path "./processor*/[0-9]*/polyMesh/pointProcAddressing" -print -quit 2>/dev/null | grep -q .; then
                        skipReconstructMesh=false
                    fi
                fi
            fi
        fi

        if [[ "$skipReconstructMesh" == true ]]; then
            printf "[INFO]  %-40s\n" "Reconstructing dynamic mesh (already completed)"
        else
            printf "[RUN]   %-40s\n" "Reconstructing dynamic mesh"
            echo "Reconstructing Mesh" > log/.batch_stage
            if ! reconstructParMesh $fileHandlerArg $reconstructionRegionArg \
                >> log/log.reconstructParMesh 2>&1
            then
                reconstructSuccess=false
                echo ""
                printf "[ERROR] reconstructParMesh failed. Processor directories preserved.\n" >&2
                printf "        Please check log/log.reconstructParMesh for details.\n"
            fi
        fi
    fi

    if [[ "$reconstructSuccess" == true ]]
    then
        printf "[RUN]   %-40s\n" "Reconstructing results"
        echo "Reconstructing" > log/.batch_stage

        reconstructionVerificationPrepared=false
        if prepare_reconstruction_verification "$fileHandlerArg"; then
            reconstructionVerificationPrepared=true
        else
            fail 40 RECONSTRUCTION_FAILED "Cannot prepare reconstruction verification: $reconstructionVerificationError. Processor directories preserved."
        fi
        
        # Get all reconstructed times
        reconstructTimes=$(foamListTimes -processor $fileHandlerArg 2>/dev/null | grep -ve '^$' | sort -V)
        totalTimesCount=$(echo "$reconstructTimes" | grep -ve '^$' | wc -l)
        
        # Start reconstructPar in the background
        reconstructPar $fileHandlerArg $reconstructionRegionArg \
            > log/log.reconstructPar 2>&1 &
        reconstruct_pid=$!
        
        # Trap SIGINT and SIGTERM to kill reconstructPar if interrupted
        trap 'interrupt_child 130 "$reconstruct_pid"' INT
        trap 'interrupt_child 143 "$reconstruct_pid"' TERM
        
        echo -e "\n"
        
        while kill -0 "$reconstruct_pid" 2>/dev/null
        do
            sleep 1
            if [[ "$quiet" == true ]]; then continue; fi
            
            reconstructedTimesList=$(grep "^Time = " log/log.reconstructPar | awk '{print $3}')
            reconstructedCount=$(echo "$reconstructedTimesList" | grep -ve '^$' | wc -l)
            lastReconstructedTime=$(echo "$reconstructedTimesList" | tail -n 1)
            
            if [[ -z "$lastReconstructedTime" ]]; then lastReconstructedTime="N/A"; fi
            
            output=$(awk -v total="$totalTimesCount" -v current="$reconstructedCount" -v lastTime="$lastReconstructedTime" '
            BEGIN {
                prog = 0
                if (total > 0) {
                    prog = (current / total) * 100
                }
                if (prog > 100) prog = 100
                if (prog < 0) prog = 0
                
                bar_len = 40
                filled = int((prog / 100) * bar_len)
                bar = ""
                for(i=0; i<bar_len; i++) {
                    if(i < filled) bar = bar "▓"
                    else bar = bar "░"
                }
                
                printf "Progress                 : %s %.1f%%\n", bar, prog
                printf "Reconstructing Timestep  : %s s\n", lastTime
            }')
            
            if [[ "$quiet" == false ]]; then
                if [[ -n "$output" ]]
                then
                    echo -en "\033[2A"
                    while IFS= read -r line; do echo -e "\033[2K$line"; done <<< "$output"
                fi
            fi
        done
        
        wait "$reconstruct_pid"
        reconstruct_exit_status=$?
        
        # Reset trap
        trap - SIGINT SIGTERM
        
        if [ $reconstruct_exit_status -eq 0 ]
        then
            # Clear progress bar and Reconstructing Timestep lines
            if [[ "$quiet" == false ]]; then echo -en "\033[2A\033[2K\033[1B\033[2K\033[1A"; fi

            if [[ "$reconstructionVerificationPrepared" != true ]]; then
                fail 40 RECONSTRUCTION_FAILED "Verification unavailable: $reconstructionVerificationError. Processor directories preserved."
            else
                printf "[VERIFY] %-40s\n" "Checking reconstructed data"
                if verify_reconstructed_data "$fileHandlerArg" "$reconstructAllRegions"; then
                    printf "[VERIFY] %-40s\n" "Reconstructed data verified"
                    if [[ "$keepProcessors" == true ]]; then
                        printf "[KEEP]  %-40s\n" "Processor directories preserved (--keep-processors)"
                    else
                        printf "[CLEAN] %-40s\n" "Removing verified processor directories"
                        remove_verified_processor_dirs || fail 40 RECONSTRUCTION_FAILED "Verified processor cleanup failed; inspect retained data."
                    fi
                else
                    printf "[WARN]  Reconstruction verification failed.\n" >&2
                    printf "        %s. Processor directories were preserved.\n" \
                        "$reconstructionVerificationError"
                    fail 40 RECONSTRUCTION_FAILED "Reconstruction verification failed: $reconstructionVerificationError. Processor directories preserved."
                fi
            fi
        else
            echo ""
            printf "[ERROR] reconstructPar failed. Processor directories preserved.\n" >&2
            printf "        Please check log/log.reconstructPar for details.\n"
            fail 40 RECONSTRUCTION_FAILED "reconstructPar failed; see log/log.reconstructPar. Processor data preserved."
        fi
    else
        fail 40 RECONSTRUCTION_FAILED "Mesh/region reconstruction failed. Processor data preserved."
    fi
fi

echo "[DONE]  Simulation complete in $(pwd)"

if [[ "$animate" == true && "$isBatch" == false ]]; then
    echo ""
    if [[ "$quiet" == false ]]; then
        printf "[RUN]   %-40s\n" "Rendering animation"
        animateCase "${animArgs[@]}" || fail 15 PREPARATION_FAILED "Animation failed."
    else
        animateCase "${animArgs[@]}" > log/log.animateCase 2>&1 || fail 15 PREPARATION_FAILED "Animation failed; see log/log.animateCase."
    fi
fi

# Horizontal Divider
cols=$(tput cols 2>/dev/null || echo 80)
if [[ "$cols" -gt 100 ]]; then cols=100; fi
printf '%*s\n' "$cols" '' | tr ' ' '='

exit 0
